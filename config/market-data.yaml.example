polygon:
  api_key: ""
  tier: starter          # basic (free, 5/min) | starter (paid, unlimited) | developer
  # rate_per_sec: 8      # soft per-process ceiling; defaults to the tier profile
  # burst: 16
  rest_base: https://api.polygon.io

# DEV default: CNPG LAN NodePort (cluster data NS). Override via POSTGRES_* env
# or copy this file to config/market-data.yaml (gitignored) for local secrets.
# Localhost:5432 is NOT the DEV target unless you run a local Postgres.
postgres:
  host: 192.168.10.73
  port: 30432
  dbname: bifrost_golden_source
  user: data_writer
  password: ""           # set via POSTGRES_PASSWORD env

redis:
  url: redis://localhost:6379/0

worker:
  pool: stocks           # stocks | options
  concurrency: 8
  poll_interval_sec: 5
  job_timeout_sec: 900     # fail a live handler that hangs
  stale_running_sec: 1200  # reclaim running rows after worker crash / Recreate
  statement_timeout: 60s   # per-session SQL budget; the bifrost role's 2s cannot finish a batch write
